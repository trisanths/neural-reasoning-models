          "cases_enumerated": 36,
          "domain": "every object paired with every object",
          "method": "exhaustive enumeration by the reference implementation"
        },
        "proof": [
          {
            "cites": "D5",
            "text": "Suppose e and f both leave every aztfal unchanged."
          },
          {
            "cites": "A4",
            "text": "Then e & f = f, reading e as neutral on the left."
          },
          {
            "cites": "A4",
            "text": "And e & f = e, reading f as neutral on the right."
          },
          {
            "cites": null,
            "text": "So e = f, and the two suppositions describe the same object."
          }
        ]
      }
    },
    {
      "node_id": "T2",
      "kind": "theorem",
      "key": "thm:anchor_in_core",
      "theme": "operations",
      "title": "the nyrvor lies in the nakpyr",
      "statement": "The nyrvor muxzels with every aztfal.",
      "depends_on": [
        "D5",
        "D6"
      ],
      "layer": 5,
      "chapter": 7,
      "payload": {
        "witness": {
          "anchor": "korrhob",
          "core": [
            "korrhob",
            "pyrnak",
            "korrglim",
            "lornjen",
            "nakqen",
            "aztclo"
          ]
        },
        "verification": {
          "result": true,
          "cases_enumerated": 6,
          "domain": "the anchor against every object",
          "method": "exhaustive enumeration by the reference implementation"
        },
        "proof": [
          {
            "cites": "D5",
            "text": "Let e be the nyrvor and x any aztfal."
          },
          {
            "cites": "D5",
            "text": "Then e & x = x and x & e = x."
          },
          {
            "cites": "D2",
            "text": "So e & x = x & e, which is what it means to muxzel."
          },
          {
            "cites": "D6",
            "text": "Since x was arbitrary, e belongs to the nakpyr."
          }
        ]
      }
    },
    {
      "node_id": "T3",
      "kind": "theorem",
      "key": "thm:core_sealed",
      "theme": "operations",
      "title": "the nakpyr is vintpon",
      "statement": "If x and y both muxzel with every aztfal, then so does x & y.",
      "depends_on": [
        "D6",
        "D3",
        "A2"
      ],
      "layer": 5,
      "chapter": 7,
      "payload": {
        "witness": {
          "core": [
            "korrhob",
            "pyrnak",
            "korrglim",
            "lornjen",
            "nakqen",
            "aztclo"
          ]
        },
        "verification": {
          "result": true,
          "cases_enumerated": 36,
          "domain": "every ordered pair drawn from the core",
          "method": "exhaustive enumeration by the reference implementation"
        },
        "proof": [
          {
            "cites": "D6",
            "text": "Let x and y lie in the nakpyr and let z be any aztfal."
          },
          {
            "cites": "A2",
            "text": "Then (x & y) & z = x & (y & z)."
          },
          {
            "cites": "D6",
            "text": "Move z past y, then past x, using that each muxzels with everything."
          },
          {
            "cites": "D3",
            "text": "So x & y muxzels with z, and the nakpyr is vintpon."
          }
        ]
      }
    },
    {
      "node_id": "T4",
      "kind": "theorem",
      "key": "thm:span_sealed",
      "theme": "collections",
      "title": "the quilnak of a aztfal is vintpon",
      "statement": "For every aztfal x, the collection [x] is vintpon.",
      "depends_on": [
        "D8",
        "D3"
      ],
      "layer": 5,
      "chapter": 8,
      "payload": {
        "witness": null,
        "verification": {
          "result": true,
          "cases_enumerated": 216,
          "domain": "every object, then every pair inside its span",
          "method": "exhaustive enumeration by the reference implementation"
        },
        "proof": [
          {
            "cites": "D8",
            "text": "[x] is built by taking x and closing under &."
          },
          {
            "cites": "D3",
            "text": "Closing under an operation is exactly the sealing condition."
          },
          {
            "cites": null,
            "text": "The carrier is finite, so the closure stops after finitely many rounds."
          }
        ]
      }
    },
    {
      "node_id": "T5",
      "kind": "theorem",
      "key": "thm:span_smallest",
      "theme": "collections",
      "title": "the quilnak is contained in every vintpon collection",
      "statement": "If S is vintpon and contains x, then S contains all of [x].",
      "depends_on": [
        "D8",
        "T4"
      ],
      "layer": 6,
      "chapter": 9,
      "payload": {
        "witness": {
          "sealed_count": 45
        },
        "verification": {
          "result": true,
          "cases_enumerated": 270,
          "domain": "every sealed collection against every object",
          "method": "exhaustive enumeration by the reference implementation"
        },
        "proof": [
          {
            "cites": "D8",
            "text": "Every member of [x] is reached from x by finitely many applications of the operation."
          },
          {
            "cites": "D3",
            "text": "A sealed S containing x is closed under each of those applications."
          },
          {
            "cites": null,
            "text": "So each member of [x] is in S, by induction on the number of applications."
          }
        ]
      }
    },
    {
      "node_id": "T6",
      "kind": "theorem",
      "key": "thm:steady_iff_reach_one",
      "theme": "collections",
      "title": "a aztfal is vorduth exactly when its duthnyr is one",
      "statement": "x & x = x holds if and only if [x] contains x alone.",
      "depends_on": [
        "D1",
        "D11",
        "T4"
      ],
      "layer": 6,
      "chapter": 9,
      "payload": {
        "witness": null,
        "verification": {
          "result": true,
          "cases_enumerated": 6,
          "domain": "every object",
          "method": "exhaustive enumeration by the reference implementation"
        },
        "proof": [
          {
            "cites": "D1",
            "text": "If x & x = x then {x} is already closed under &."
          },
          {
            "cites": "T4",
            "text": "So [x] = {x} and the duthnyr is one."
          },
          {
            "cites": "D11",
            "text": "Conversely a span of one object must contain x & x, which is then x."
          }
        ]
      }
    },
