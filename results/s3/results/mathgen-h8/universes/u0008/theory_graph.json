        "proof": [
          {
            "cites": "D6",
            "text": "Let x and y lie in the glimdri and let z be any ovimorn."
          },
          {
            "cites": "A2",
            "text": "Then (x : y) : z = x : (y : z)."
          },
          {
            "cites": "D6",
            "text": "Move z past y, then past x, using that each naklorns with everything."
          },
          {
            "cites": "D3",
            "text": "So x : y naklorns with z, and the glimdri is vexjen."
