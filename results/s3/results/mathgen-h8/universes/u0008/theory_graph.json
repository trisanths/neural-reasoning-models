    {
      "node_id": "R1",
      "kind": "refutation",
      "key": "axiom_fails:idempotence_first",
      "theme": "operations",
      "title": "the system does not have self combination under the first operation",
      "statement": "It is not the case that: For every ovimorn x: x : x = x.",
      "depends_on": [
        "S2"
      ],
      "layer": 2,
      "chapter": 0,
      "payload": {
        "axiom": "idempotence_first",
        "witness": {
          "x": "bradri",
          "value": "wrenkorr"
        },
        "verification": {
          "result": false,
          "cases_enumerated": 125,
          "domain": "every tuple of the carrier the axiom quantifies over",
          "method": "exhaustive enumeration by the reference implementation"
        },
        "proof": [
          {
            "cites": "S2",
            "text": "Take the case x = bradri, value = wrenkorr, read straight from the tables."
          },
          {
            "cites": "S2",
            "text": "The two sides of the claim come apart on that case, so the claim cannot hold for every case."
          },
          {
            "cites": null,
            "text": "One counterexample is enough. Note that the claim may still hold for many particular objects; what fails is the universal reading."
          }
        ]
      }
    },
