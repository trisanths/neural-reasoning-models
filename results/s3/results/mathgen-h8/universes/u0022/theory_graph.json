    {
      "node_id": "T10",
      "kind": "theorem",
      "key": "thm:shadow_nested",
      "theme": "relation",
      "title": "zelfexs are nested along the relation",
      "statement": "If y lies in the zelfex of x, then the zelfex of y is contained in the zelfex of x.",
      "depends_on": [
        "D4",
        "A9"
      ],
      "layer": 3,
      "chapter": 4,
      "payload": {
        "witness": null,
        "verification": {
          "result": true,
