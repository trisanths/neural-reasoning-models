          "domain": "every ordered triple",
          "method": "exhaustive enumeration by the reference implementation"
        },
        "proof": [
          {
            "cites": "D4",
            "text": "Let y satisfy x << y and let z satisfy y << z."
          },
          {
            "cites": "A9",
            "text": "Transitivity gives x << z."
          },
          {
            "cites": "D4",
            "text": "So every member of the zelfex of y is a member of that of x."
          }
        ]
      }
