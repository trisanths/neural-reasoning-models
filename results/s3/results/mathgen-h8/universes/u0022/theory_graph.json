    {
      "node_id": "R1",
      "kind": "refutation",
      "key": "axiom_fails:inverses_first",
      "theme": "neutral",
      "title": "the system does not have reversal under the first operation",
      "statement": "Some driwren x admits no driwren y for which x * y and y * x both land on a neutral object.",
      "depends_on": [
        "S2"
      ],
      "layer": 2,
      "chapter": 1,
      "payload": {
        "axiom": "inverses_first",
        "witness": {
          "x": "soltarn"
        },
        "verification": {
          "result": false,
          "cases_enumerated": 216,
          "domain": "every tuple of the carrier the axiom quantifies over",
          "method": "exhaustive enumeration by the reference implementation"
        },
        "proof": [
          {
            "cites": "S2",
            "text": "Take the case x = soltarn, read straight from the tables."
          },
          {
            "cites": "S2",
            "text": "The two sides of the claim come apart on that case, so the claim cannot hold for every case."
          },
          {
            "cites": null,
            "text": "One counterexample is enough. Note that the claim may still hold for many particular objects; what fails is the universal reading."
          }
        ]
      }
    },
